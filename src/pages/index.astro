---
import '../styles/global.css';
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/jpg" href="/logo.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reserva Ecológica Valentura</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-bosque-dark text-white font-['Plus_Jakarta_Sans',sans-serif] antialiased min-h-screen selection:bg-dorado-primary selection:text-bosque-dark relative">

    <!-- NAVBAR CON NAVEGACIÓN ACTIVA -->
    <header class="border-b border-white/10 backdrop-blur-md bg-bosque-dark/90 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 py-3.5 flex justify-between items-center">
        
        <a href="#inicio" class="flex items-center space-x-3 group">
          <img 
            src="/logo.jpg" 
            alt="Logo Reserva Ecológica Valentura" 
            class="w-11 h-11 rounded-full border border-dorado-primary/40 object-cover group-hover:scale-105 transition duration-300 shadow-md" 
          />
          <div>
            <span class="font-['Cinzel'] tracking-widest text-[10px] uppercase block text-gray-300 font-semibold leading-none">Reserva Ecológica</span>
            <span class="font-['Cinzel'] text-base tracking-widest text-dorado-primary font-bold block -mt-0.5">VALENTURA</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-8 text-xs font-light text-gray-300 uppercase tracking-wider">
          <a href="#inicio" class="nav-link transition pb-0.5" data-section="inicio">Inicio</a>
          <a href="#hospedaje" class="nav-link transition pb-0.5" data-section="hospedaje">Alojamiento</a>
          <a href="#santuario" class="nav-link transition pb-0.5" data-section="santuario">Fauna</a>
          <a href="#comunidad" class="nav-link transition pb-0.5" data-section="comunidad">Comunidad</a>
          <a href="#reserva" class="nav-link transition pb-0.5" data-section="reserva">Reserva</a>
        </nav>
      </div>
    </header>

    <!-- HERO SECTION -->
    <section id="inicio" class="relative min-h-[80vh] flex items-center px-6 py-12 border-b border-white/5 overflow-hidden">
      <img 
        src="/hero-background-ia.jpg" 
        alt="Paisaje de la Reserva Ecológica Valentura" 
        class="absolute inset-0 w-full h-full object-cover z-0 filter brightness-[0.7]" 
      />
      
      <div class="absolute inset-0 bg-gradient-to-r from-bosque-dark/95 via-bosque-dark/75 to-transparent z-10"></div>

      <div class="max-w-7xl mx-auto w-full relative z-20 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8">
          <span class="text-dorado-light text-xs tracking-widest uppercase mb-3 block font-medium">Bienvenidos a la experiencia natural</span>
          <h1 class="font-['Cinzel'] text-4xl sm:text-5xl md:text-6xl font-normal text-white leading-tight mb-4 drop-shadow-md">
            Reserva Ecológica <br/>
            <span class="text-dorado-primary font-bold italic">Valentura</span>
          </h1>
          <p class="text-gray-200 text-base sm:text-lg mb-8 max-w-xl font-light leading-relaxed drop-shadow">
            Naturaleza, aventura y vida silvestre en el corazón de Mindo. Un refugio único para conectar con la paz del bosque.
          </p>
          <a href="#hospedaje" class="inline-flex items-center gap-3 bg-dorado-primary hover:bg-dorado-light text-bosque-dark px-7 py-3.5 rounded-full text-xs font-bold tracking-wider uppercase transition duration-300 shadow-2xl">
            Explorar la reserva <span class="text-sm">→</span>
          </a>
        </div>

        <div class="md:col-span-4 justify-self-end w-full max-w-xs">
          <div id="open-resenas-hero" class="bg-bosque-card/95 backdrop-blur-md border border-white/10 p-4 rounded-2xl flex items-center space-x-3.5 shadow-2xl cursor-pointer hover:border-dorado-primary transition group">
            <div class="w-10 h-10 rounded-xl bg-bosque-accent flex items-center justify-center text-dorado-primary text-lg border border-white/5 group-hover:scale-110 transition">📍</div>
            <div class="text-xs">
              <p class="font-medium text-white">Mindo, Ecuador</p>
              <p class="text-gray-400 text-[11px]">San Miguel de los Bancos</p>
              <div class="flex items-center gap-1 mt-1 text-dorado-primary text-[11px]">
                <span id="puntuacion-promedio-hero" class="font-bold">4.9</span> 
                <span>★★★★★</span> 
                <span class="text-gray-400 font-normal hover:underline">(ver reseñas)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- GRID DE EXPERIENCIAS -->
    <section id="experiencias" class="max-w-7xl mx-auto px-6 py-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        
        <a href="#hospedaje" class="bg-bosque-card border border-white/5 rounded-2xl overflow-hidden flex flex-col justify-end hover:border-dorado-primary/50 transition duration-300 group cursor-pointer min-h-[240px] relative p-5">
          <img src="/cabaña-principal.jpg" alt="Hospedaje" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 brightness-[0.65]" />
          <div class="absolute inset-0 bg-gradient-to-t from-bosque-dark via-bosque-dark/30 to-transparent"></div>
          <div class="relative z-10">
            <h3 class="font-semibold text-sm text-white group-hover:text-dorado-primary transition font-['Cinzel'] tracking-wide">Hospedaje</h3>
            <p class="text-[11px] text-gray-300 mt-1 leading-snug">Cabañas ecológicas inmersas en el bosque</p>
          </div>
        </a>

        <a href="#santuario" class="bg-bosque-card border border-white/5 rounded-2xl overflow-hidden flex flex-col justify-end hover:border-dorado-primary/50 transition duration-300 group cursor-pointer min-h-[240px] relative p-5">
          <img src="/tucan.jpg" alt="Flora y fauna" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 brightness-[0.65]" />
          <div class="absolute inset-0 bg-gradient-to-t from-bosque-dark via-bosque-dark/30 to-transparent"></div>
          <div class="relative z-10">
            <h3 class="font-semibold text-sm text-white group-hover:text-dorado-primary transition font-['Cinzel'] tracking-wide">Flora y fauna</h3>
            <p class="text-[11px] text-gray-300 mt-1 leading-snug">Especies únicas de la región</p>
          </div>
        </a>

        <a href="#santuario" class="bg-bosque-card border border-white/5 rounded-2xl overflow-hidden flex flex-col justify-end hover:border-dorado-primary/50 transition duration-300 group cursor-pointer min-h-[240px] relative p-5">
          <img src="/perrito.jpg" alt="Santuario" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 brightness-[0.65]" />
          <div class="absolute inset-0 bg-gradient-to-t from-bosque-dark via-bosque-dark/30 to-transparent"></div>
          <div class="relative z-10">
            <h3 class="font-semibold text-sm text-white group-hover:text-dorado-primary transition font-['Cinzel'] tracking-wide">Santuario de animales</h3>
            <p class="text-[11px] text-gray-300 mt-1 leading-snug">Protegemos la vida silvestre</p>
          </div>
        </a>

        <a href="#santuario" class="bg-bosque-card border border-white/5 rounded-2xl overflow-hidden flex flex-col justify-end hover:border-dorado-primary/50 transition duration-300 group cursor-pointer min-h-[240px] relative p-5">
          <img src="/cascada.jpg" alt="Cascadas y ríos" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 brightness-[0.65]" />
          <div class="absolute inset-0 bg-gradient-to-t from-bosque-dark via-bosque-dark/30 to-transparent"></div>
          <div class="relative z-10">
            <h3 class="font-semibold text-sm text-white group-hover:text-dorado-primary transition font-['Cinzel'] tracking-wide">Cascadas y ríos</h3>
            <p class="text-[11px] text-gray-300 mt-1 leading-snug">Aguas cristalinas y paisajes mágicos</p>
          </div>
        </a>

        <a href="#comunidad" class="bg-bosque-card border border-white/5 rounded-2xl overflow-hidden flex flex-col justify-end hover:border-dorado-primary/50 transition duration-300 group cursor-pointer min-h-[240px] relative p-5">
          <img src="/comunidad.jpg" alt="Comunidad" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 brightness-[0.65]" />
          <div class="absolute inset-0 bg-gradient-to-t from-bosque-dark via-bosque-dark/30 to-transparent"></div>
          <div class="relative z-10">
            <h3 class="font-semibold text-sm text-white group-hover:text-dorado-primary transition font-['Cinzel'] tracking-wide">Comunidad</h3>
            <p class="text-[11px] text-gray-300 mt-1 leading-snug">Cultura, tradición y gente local</p>
          </div>
        </a>

      </div>
    </section>

    <!-- SECCIÓN HOSPEDAJE -->
    <section id="hospedaje" class="max-w-7xl mx-auto px-6 py-16 border-t border-white/5">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-dorado-light text-xs tracking-widest uppercase font-semibold mb-2 block">Alojamiento Exclusivo</span>
        <h2 class="font-['Cinzel'] text-4xl sm:text-5xl font-normal text-white tracking-wide">Nuestras Cabañas</h2>
        <p class="text-sm text-gray-400 mt-3 font-light">Espacios íntimos y confortables integrados por completo con la naturaleza de Mindo.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        
        <!-- Cabaña Familiar Bosque -->
        <div id="card-familiar" class="card-hospedaje bg-bosque-card rounded-3xl overflow-hidden border border-white/10 hover:border-dorado-primary/50 transition group flex flex-col justify-between shadow-2xl">
          <div class="h-72 relative overflow-hidden flex items-center justify-center">
            <img src="/cabaña-principal.jpg" alt="Cabaña Familiar Bosque" class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition duration-500" />
            <span class="absolute top-4 right-4 bg-bosque-dark/90 backdrop-blur-md px-3 py-1 rounded-full text-xs text-dorado-light border border-white/10 z-10 font-medium">Más Popular</span>
          </div>
          <div class="p-8 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-['Cinzel'] text-xl text-white group-hover:text-dorado-primary transition font-semibold">Cabaña Familiar Bosque</h3>
              <p class="text-xs text-gray-300 mt-2 leading-relaxed font-light">3 Habitaciones privadas · Sala acogedora · Baño privado con agua caliente · Wi-Fi de alta velocidad</p>
            </div>
            
            <div class="flex flex-wrap sm:flex-nowrap justify-between items-center mt-8 pt-5 border-t border-white/10 gap-3">
              <button class="btn-detalles bg-bosque-dark hover:bg-white/10 text-dorado-light px-4 py-2.5 rounded-xl text-xs font-semibold transition border border-dorado-primary/30 flex items-center gap-2" data-cabana="familiar">
                <span>👁️</span> Ver detalles e interior
              </button>
              <div class="flex items-center gap-4">
                <div>
                  <span class="text-2xl font-bold text-dorado-primary">$70</span>
                  <span class="text-[11px] text-gray-400">/noche</span>
                </div>
                <button class="btn-reservar-card bg-dorado-primary hover:bg-dorado-light text-bosque-dark px-5 py-2.5 rounded-xl text-xs font-bold transition shadow-md" data-cabana-tipo="familiar" data-nombre="Cabaña Familiar Bosque" data-precio="70">
                  Reservar →
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Cabaña Nido -->
        <div id="card-nido" class="card-hospedaje bg-bosque-card rounded-3xl overflow-hidden border border-white/10 hover:border-dorado-primary/50 transition group flex flex-col justify-between shadow-2xl">
          <div class="h-72 relative overflow-hidden flex items-center justify-center">
            <img src="/cabaña-secundaria.jpg" alt="Cabaña Nido" class="absolute inset-0 w-full h-full object-cover object-top group-hover:scale-105 transition duration-500" />
            <span class="absolute top-4 right-4 bg-bosque-dark/90 backdrop-blur-md px-3 py-1 rounded-full text-xs text-dorado-light border border-white/10 z-10 font-medium">Acogedora</span>
          </div>
          <div class="p-8 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-['Cinzel'] text-xl text-white group-hover:text-dorado-primary transition font-semibold">Cabaña Nido</h3>
              <p class="text-xs text-gray-300 mt-2 leading-relaxed font-light">1 Habitación amplia · 2 camas confortables · Sala de estar integrada · Wi-Fi · Vista al bosque</p>
            </div>
            
            <div class="flex flex-wrap sm:flex-nowrap justify-between items-center mt-8 pt-5 border-t border-white/10 gap-3">
              <button class="btn-detalles bg-bosque-dark hover:bg-white/10 text-dorado-light px-4 py-2.5 rounded-xl text-xs font-semibold transition border border-dorado-primary/30 flex items-center gap-2" data-cabana="nido">
                <span>👁️</span> Ver detalles e interior
              </button>
              <div class="flex items-center gap-4">
                <div>
                  <span class="text-2xl font-bold text-dorado-primary">$40</span>
                  <span class="text-[11px] text-gray-400">/noche</span>
                </div>
                <button class="btn-reservar-card bg-dorado-primary hover:bg-dorado-light text-bosque-dark px-5 py-2.5 rounded-xl text-xs font-bold transition shadow-md" data-cabana-tipo="nido" data-nombre="Cabaña Nido" data-precio="40">
                  Reservar →
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- SANTUARIO DE ANIMALES -->
    <section id="santuario" class="max-w-7xl mx-auto px-6 py-12 border-t border-white/5">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <span class="text-dorado-primary text-xs uppercase tracking-widest font-semibold block mb-1">Fauna Protegida</span>
          <h2 class="font-['Cinzel'] text-3xl text-white font-normal mb-3">Santuario de animales</h2>
          <p class="text-xs text-gray-300 leading-relaxed mb-6 font-light">
            Refugio para diversas especies nativas rescatadas y rehabilitadas. Visita de manera responsable y apoya nuestra labor de conservación.
          </p>

          <div class="grid grid-cols-2 gap-4 text-xs">
            <div class="bg-bosque-card p-3.5 rounded-xl border border-white/5">
              <p class="text-dorado-primary font-bold text-base">40+</p>
              <p class="text-gray-400 text-[11px]">Especies protegidas</p>
            </div>
            <div class="bg-bosque-card p-3.5 rounded-xl border border-white/5">
              <p class="text-dorado-primary font-bold text-base">100%</p>
              <p class="text-gray-400 text-[11px]">Libre e integrado</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="h-40 rounded-2xl overflow-hidden border border-white/5 relative">
            <img src="/perrito.jpg" alt="Santuario animal" class="w-full h-full object-cover" />
          </div>
          <div class="h-40 rounded-2xl overflow-hidden border border-white/5 relative">
            <img src="/tucan.jpg" alt="Tucán de Mindo" class="w-full h-full object-cover" />
          </div>
          <div class="h-40 rounded-2xl overflow-hidden border border-white/5 relative">
            <img src="/cascada.jpg" alt="Cascadas" class="w-full h-full object-cover" />
          </div>
          <div class="h-40 rounded-2xl overflow-hidden border border-white/5 relative">
            <img src="/cabaña-principal.jpg" alt="Reserva" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- COMUNIDAD -->
    <section id="comunidad" class="max-w-7xl mx-auto px-6 py-12 border-t border-white/5">
      <div class="bg-bosque-card rounded-3xl p-8 border border-white/10 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-5 h-56 rounded-2xl overflow-hidden border border-white/5 relative">
          <img src="/comunidad.jpg" alt="Comunidad local" class="w-full h-full object-cover" />
        </div>
        <div class="md:col-span-7">
          <span class="text-dorado-primary text-xs uppercase tracking-widest font-semibold block mb-1">Impacto Social</span>
          <h2 class="font-['Cinzel'] text-2xl text-white font-normal mb-3">Comunidad y Cultura</h2>
          <p class="text-xs text-gray-300 leading-relaxed mb-6 font-light">
            Trabajamos mano a mano con familias locales para brindar experiencias auténticas de turismo sostenible, gastronomía artesanal y guianza tradicional.
          </p>
          <a href="#reserva" class="inline-block bg-bosque-accent hover:bg-white/10 text-dorado-light border border-dorado-primary/30 px-5 py-2.5 rounded-full text-xs transition">
            Conoce a nuestros guías →
          </a>
        </div>
      </div>
    </section>

    <!-- RESERVA Y MÉTODO DE PAGO -->
    <section id="reserva" class="max-w-7xl mx-auto px-6 py-12 border-t border-white/5">
      <div class="grid lg:grid-cols-12 gap-8">
        
        <div class="lg:col-span-8 bg-bosque-card rounded-3xl p-8 border border-white/10 shadow-2xl">
          <h2 class="font-['Cinzel'] text-2xl font-normal text-white mb-1">Reserva tu experiencia</h2>
          <p class="text-xs text-gray-400 mb-8">Elige tus fechas y asegura tu estancia en la Reserva Ecológica Valentura.</p>

          <form id="reserva-form" class="space-y-6">
            
            <div>
              <label class="text-xs text-dorado-light font-medium block mb-2">Selecciona tu Cabaña</label>
              <select id="cabana-select" class="w-full bg-bosque-dark border border-white/10 rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:border-dorado-primary">
                <option value="familiar" data-precio="70" data-nombre="Cabaña Familiar Bosque">Cabaña Familiar Bosque ($70/noche)</option>
                <option value="nido" data-precio="40" data-nombre="Cabaña Nido">Cabaña Nido ($40/noche)</option>
              </select>
            </div>

            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label class="text-xs text-dorado-light font-medium block mb-2">1. Fechas de entrada y salida</label>
                <div class="grid grid-cols-2 gap-2">
                  <input type="date" id="fecha-entrada" class="bg-bosque-dark border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary" required />
                  <input type="date" id="fecha-salida" class="bg-bosque-dark border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary" required />
                </div>
              </div>

              <div>
                <label class="text-xs text-dorado-light font-medium block mb-2">2. Número de noches y huéspedes</label>
                <div class="grid grid-cols-3 gap-2">
                  <select id="noches-select" class="bg-bosque-dark border border-white/10 rounded-xl px-2 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary">
                    <option value="1">1 Noche</option>
                    <option value="2" selected>2 Noches</option>
                    <option value="3">3 Noches</option>
                    <option value="4">4 Noches</option>
                    <option value="5">5 Noches</option>
                  </select>
                  <select id="adultos-select" class="bg-bosque-dark border border-white/10 rounded-xl px-2 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary">
                    <option>1 Adulto</option>
                    <option selected>2 Adultos</option>
                    <option>3 Adultos</option>
                    <option>4 Adultos</option>
                    <option>5+ Adultos</option>
                  </select>
                  <select id="ninos-select" class="bg-bosque-dark border border-white/10 rounded-xl px-2 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary">
                    <option selected>0 Niños</option>
                    <option>1 Niño</option>
                    <option>2 Niños</option>
                    <option>3 Niños</option>
                    <option>4+ Niños</option>
                  </select>
                </div>
              </div>
            </div>

            <div>
              <label class="text-xs text-dorado-light font-medium block mb-2">3. Método de Pago</label>
              <div class="grid grid-cols-2 gap-3 text-xs">
                <label class="flex items-center space-x-3 bg-bosque-dark p-3 rounded-xl border border-white/10 cursor-pointer hover:border-dorado-primary">
                  <input type="radio" name="pago" value="Transferencia / Depósito" checked class="accent-dorado-primary" />
                  <span>Transferencia / Depósito</span>
                </label>
                <label class="flex items-center space-x-3 bg-bosque-dark p-3 rounded-xl border border-white/10 cursor-pointer hover:border-dorado-primary">
                  <input type="radio" name="pago" value="Pago al llegar" class="accent-dorado-primary" />
                  <span>Pago al llegar</span>
                </label>
              </div>
            </div>

            <div class="grid md:grid-cols-2 gap-3 pt-2">
              <button type="submit" class="w-full bg-dorado-primary hover:bg-dorado-light text-bosque-dark py-3 rounded-xl text-xs font-bold tracking-wide transition shadow-lg">
                Confirmar reserva →
              </button>
              
              <button type="button" id="btn-whatsapp-reserva" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white py-3 rounded-xl text-xs font-bold tracking-wide transition shadow-lg flex items-center justify-center gap-2">
                <span>💬</span> Reservar por WhatsApp
              </button>
            </div>
          </form>
        </div>

        <div class="lg:col-span-4 bg-bosque-card rounded-3xl p-6 border border-white/10 flex flex-col justify-between">
          <div>
            <h3 class="font-['Cinzel'] text-lg text-white mb-4">Resumen de tu reserva</h3>
            <div class="space-y-3 text-xs border-b border-white/10 pb-4">
              <div class="flex justify-between text-gray-300">
                <span id="resumen-nombre">Cabaña Familiar Bosque (2 noches)</span>
                <span id="resumen-precio" class="text-white font-medium">$140</span>
              </div>
            </div>
            <div class="flex justify-between items-center mt-4">
              <span class="font-semibold text-white text-sm">Total</span>
              <span id="resumen-total" class="text-xl font-bold text-dorado-primary">$140</span>
            </div>
          </div>

          <div class="mt-6 bg-bosque-dark/60 p-4 rounded-xl border border-white/5 text-[11px] text-gray-400">
            🔒 Tu reserva está protegida con cancelación flexible hasta 48 horas antes.
          </div>
        </div>

      </div>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-white/10 bg-bosque-dark py-10 px-6 text-center text-xs text-gray-400">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
        <p>© 2026 Reserva Ecológica Valentura. Todos los derechos reservados.</p>
        <div class="flex items-center space-x-4">
          <a href="https://www.tiktok.com/@velentura?is_from_webapp=1&sender_device=pc" target="_blank" class="bg-bosque-card hover:bg-dorado-primary hover:text-bosque-dark text-white px-4 py-2 rounded-xl border border-white/10 transition flex items-center gap-2 font-medium">
            <span>🎵</span> TikTok: @velentura
          </a>
        </div>
      </div>
    </footer>

    <!-- BOTÓN FLOTANTE DE WHATSAPP -->
    <a href="https://wa.me/593995617678?text=Hola%20Reserva%20Ecologica%20Valentura,%20deseo%20mas%20informacion." target="_blank" class="fixed bottom-6 right-6 z-40 bg-[#25D366] hover:bg-[#20ba5a] text-white w-14 h-14 rounded-full shadow-2xl flex items-center justify-center text-3xl transition hover:scale-110" title="Escríbenos por WhatsApp">
      <svg viewBox="0 0 24 24" width="30" height="30" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="text-white fill-white"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
    </a>

    <!-- MODAL DE DETALLES E INTERIOR -->
    <div id="modal-cabana-detalles" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden items-center justify-center p-4">
      <div class="bg-bosque-card border border-white/10 w-full max-w-2xl rounded-3xl p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
        
        <button id="close-modal-detalles" class="absolute top-4 right-4 text-gray-400 hover:text-white text-lg font-bold">✕</button>

        <span class="text-dorado-primary text-xs uppercase tracking-widest font-semibold block mb-1">Distribución del espacio</span>
        <h3 id="modal-cabana-titulo" class="font-['Cinzel'] text-2xl text-white mb-4">Detalles de la Cabaña</h3>

        <p id="modal-cabana-descripcion" class="text-xs text-gray-300 leading-relaxed mb-6 font-light bg-bosque-dark/60 p-4 rounded-xl border border-white/5"></p>

        <div class="mb-6">
          <h4 class="text-xs font-semibold text-dorado-light uppercase tracking-wider mb-3">Habitaciones y Comodidades</h4>
          <ul id="modal-cabana-lista" class="grid sm:grid-cols-2 gap-2 text-xs text-gray-300"></ul>
        </div>

        <div>
          <h4 class="text-xs font-semibold text-dorado-light uppercase tracking-wider mb-3">Vista del Interior</h4>
          <div id="modal-cabana-galeria" class="grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
        </div>

        <div class="mt-8 pt-4 border-t border-white/10 flex justify-between items-center">
          <button id="modal-btn-regresar" class="bg-bosque-dark hover:bg-white/10 text-gray-300 px-5 py-2.5 rounded-xl text-xs font-medium transition border border-white/10">
            ← Volver a Alojamientos
          </button>
          <button id="modal-btn-reservar-directo" class="bg-dorado-primary hover:bg-dorado-light text-bosque-dark px-6 py-2.5 rounded-xl text-xs font-bold transition">
            Ir a reservar esta cabaña →
          </button>
        </div>

      </div>
    </div>

    <!-- MODAL DE RESEÑAS -->
    <div id="modal-resenas" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden items-center justify-center p-4">
      <div class="bg-bosque-card border border-white/10 w-full max-w-lg rounded-3xl p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
        <button id="close-modal-resenas" class="absolute top-4 right-4 text-gray-400 hover:text-white text-lg font-bold">✕</button>
        <h3 class="font-['Cinzel'] text-xl text-white mb-1">Opiniones de Visitantes</h3>
        <p class="text-xs text-gray-400 mb-6">Comparte tu experiencia en Reserva Ecológica Valentura</p>
        
        <form id="form-nueva-resena" class="bg-bosque-dark p-4 rounded-2xl border border-white/5 mb-6 space-y-3">
          <h4 class="text-xs font-semibold text-dorado-light uppercase tracking-wider">Escribir una reseña</h4>
          <div>
            <label class="text-[11px] text-gray-300 block mb-1">Calificación:</label>
            <div class="flex gap-2 text-xl cursor-pointer" id="selector-estrellas">
              <span data-rating="1" class="star hover:scale-110 transition opacity-50">★</span>
              <span data-rating="2" class="star hover:scale-110 transition opacity-50">★</span>
              <span data-rating="3" class="star hover:scale-110 transition opacity-50">★</span>
              <span data-rating="4" class="star hover:scale-110 transition opacity-50">★</span>
              <span data-rating="5" class="star hover:scale-110 transition text-dorado-primary">★</span>
            </div>
          </div>
          <div>
            <input type="text" id="nombre-resena" placeholder="Tu Nombre" class="w-full bg-bosque-card border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary" required />
          </div>
          <div>
            <textarea id="comentario-resena" rows="2" placeholder="Cuéntanos tu experiencia..." class="w-full bg-bosque-card border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary" required></textarea>
          </div>
          <button type="submit" class="w-full bg-dorado-primary hover:bg-dorado-light text-bosque-dark py-2 rounded-xl text-xs font-bold transition">Publicar Reseña</button>
        </form>

        <div class="space-y-3">
          <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Reseñas de la comunidad</h4>
          <div id="contenedor-resenas-lista" class="space-y-3 max-h-60 overflow-y-auto pr-1"></div>
        </div>
      </div>
    </div>

    <!-- SCRIPT DE FUNCIONALIDAD COMPLETA -->
    <script>
      let alojamientoSeleccionado = 'Cabaña Familiar Bosque';
      let precioSeleccionado = 70;
      let numeroNoches = 2;

      // Resaltar sección activa en el menú al hacer scroll
      const sections = document.querySelectorAll('section[id]');
      const navLinks = document.querySelectorAll('.nav-link');

      window.addEventListener('scroll', () => {
        let scrollY = window.pageYOffset;
        sections.forEach(section => {
          const sectionHeight = (section as HTMLElement).offsetHeight;
          const sectionTop = (section as HTMLElement).offsetTop - 100;
          const sectionId = section.getAttribute('id');
          if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
            navLinks.forEach(link => {
              link.classList.remove('text-dorado-primary', 'border-b', 'border-dorado-primary');
              if (link.getAttribute('data-section') === sectionId) {
                link.classList.add('text-dorado-primary', 'border-b', 'border-dorado-primary');
              }
            });
          }
        });
      });

      // Navegación fluida
      navLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = link.getAttribute('href');
          if (targetId && targetId.startsWith('#')) {
            document.querySelector(targetId)?.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      const cabanaSelect = document.getElementById('cabana-select') as HTMLSelectElement;
      const cardFamiliar = document.getElementById('card-familiar');
      const cardNido = document.getElementById('card-nido');

      function actualizarResumen() {
        const elementoNombre = document.getElementById('resumen-nombre');
        const elementoPrecio = document.getElementById('resumen-precio');
        const elementoTotal = document.getElementById('resumen-total');
        if (elementoNombre) elementoNombre.textContent = `${alojamientoSeleccionado} (${numeroNoches} ${numeroNoches === 1 ? 'noche' : 'noches'})`;
        if (elementoPrecio) elementoPrecio.textContent = `$${precioSeleccionado * numeroNoches}`;
        if (elementoTotal) elementoTotal.textContent = `$${precioSeleccionado * numeroNoches}`;
      }

      function resaltarCabanaVisual(tipo: string) {
        if (cardFamiliar && cardNido) {
          cardFamiliar.classList.remove('ring-2', 'ring-dorado-primary', 'scale-[1.02]');
          cardNido.classList.remove('ring-2', 'ring-dorado-primary', 'scale-[1.02]');
          if (tipo === 'familiar') {
            cardFamiliar.classList.add('ring-2', 'ring-dorado-primary', 'scale-[1.02]');
          } else {
            cardNido.classList.add('ring-2', 'ring-dorado-primary', 'scale-[1.02]');
          }
        }
      }

      // Cambio en el selector del formulario
      cabanaSelect?.addEventListener('change', () => {
        const selectedOption = cabanaSelect.options[cabanaSelect.selectedIndex];
        alojamientoSeleccionado = selectedOption.getAttribute('data-nombre') || 'Cabaña Familiar Bosque';
        precioSeleccionado = parseInt(selectedOption.getAttribute('data-precio') || '70');
        resaltarCabanaVisual(cabanaSelect.value);
        actualizarResumen();
      });

      // Selector de noches
      const nochesSelect = document.getElementById('noches-select') as HTMLSelectElement;
      nochesSelect?.addEventListener('change', () => {
        numeroNoches = parseInt(nochesSelect.value);
        actualizarResumen();
      });

      // Botones Reservar en las tarjetas
      const actionBtns = document.querySelectorAll('.btn-reservar-card');
      actionBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const tipoCabana = btn.getAttribute('data-cabana-tipo') || 'familiar';
          alojamientoSeleccionado = btn.getAttribute('data-nombre') || 'Cabaña Familiar Bosque';
          precioSeleccionado = parseInt(btn.getAttribute('data-precio') || '70');
          
          if (cabanaSelect) {
            cabanaSelect.value = tipoCabana;
          }
          resaltarCabanaVisual(tipoCabana);
          document.querySelector('#reserva')?.scrollIntoView({ behavior: 'smooth' });
          actualizarResumen();
        });
      });

      // WhatsApp profesional (sin emojis conflictivos)
      document.getElementById('btn-whatsapp-reserva')?.addEventListener('click', () => {
        const fechaEntrada = (document.getElementById('fecha-entrada') as HTMLInputElement)?.value;
        const fechaSalida = (document.getElementById('fecha-salida') as HTMLInputElement)?.value;
        const adultos = (document.getElementById('adultos-select') as HTMLSelectElement)?.value;
        const ninos = (document.getElementById('ninos-select') as HTMLSelectElement)?.value;
        const metodoPago = (document.querySelector('input[name="pago"]:checked') as HTMLInputElement)?.value || 'Por definir';
        if (!fechaEntrada || !fechaSalida) {
          alert('Por favor selecciona las fechas de entrada y salida.');
          return;
        }
        const mensaje = `Hola Reserva Ecologica Valentura,\n\nDeseo realizar la siguiente reserva:\n\n- Alojamiento: ${alojamientoSeleccionado}\n- Estancia: ${numeroNoches} ${numeroNoches === 1 ? 'noche' : 'noches'}\n- Entrada: ${fechaEntrada}\n- Salida: ${fechaSalida}\n- Huespedes: ${adultos}, ${ninos}\n- Metodo de Pago: ${metodoPago}\n- Total: $${precioSeleccionado * numeroNoches}\n\nTienen disponibilidad?`;
        window.open(`https://wa.me/593995617678?text=${encodeURIComponent(mensaje)}`, '_blank');
      });

      // Modal Detalles Cabañas
      const modalDetalles = document.getElementById('modal-cabana-detalles');
      const closeDetallesBtn = document.getElementById('close-modal-detalles');
      const modalRegresarBtn = document.getElementById('modal-btn-regresar');
      const modalTitulo = document.getElementById('modal-cabana-titulo');
      const modalDesc = document.getElementById('modal-cabana-descripcion');
      const modalLista = document.getElementById('modal-cabana-lista');
      const modalGaleria = document.getElementById('modal-cabana-galeria');
      const btnReservarDirecto = document.getElementById('modal-btn-reservar-directo');

      const datosCabanas: Record<string, { titulo: string; descripcion: string; caracteristicas: string[]; imagenes: string[]; nombreReserva: string; precio: number }> = {
        familiar: {
          titulo: 'Cabaña Familiar Bosque ($70/noche)',
          descripcion: 'Espaciosa cabaña de madera ideal para familias o grupos de amigos. Ofrece una distribución amplia con 3 dormitorios privados y una sala acogedora para descansar.',
          caracteristicas: [
            'Cabaña principal',
            'Cama principal',
            'Sala acogedora',
            'Sala de estar',
            'Bano privado con agua caliente',
            'Conexion Wi-Fi de alta velocidad'
          ],
          imagenes: ['/cabaña-principal.jpg', '/cama-principal.jpg', '/sala-acogedora.jpg', '/sala-estar.jpg'],
          nombreReserva: 'Cabaña Familiar Bosque',
          precio: 70
        },
        nido: {
          titulo: 'Cabaña Nido ($40/noche)',
          descripcion: 'Acogedora cabaña pensada para descanso en pareja o pequeños grupos. Dispone de 1 habitación espaciosa equipada con 2 camas confortables y sala de estar.',
          caracteristicas: [
            '1 Habitacion amplia',
            '2 Camas confortables',
            'Sala de estar integrada',
            'Bano privado con agua caliente',
            'Conexion Wi-Fi',
            'Vista panoramica al bosque'
          ],
          imagenes: ['/cabaña-secundaria.jpg', '/2-camas-confortables.jpg', '/sala-estar-2.jpg', '/vista-bosque-2.jpg'],
          nombreReserva: 'Cabaña Nido',
          precio: 40
        }
      };

      document.querySelectorAll('.btn-detalles').forEach(btn => {
        btn.addEventListener('click', () => {
          const tipo = btn.getAttribute('data-cabana') || 'familiar';
          const info = datosCabanas[tipo];

          if (info && modalTitulo && modalDesc && modalLista && modalGaleria) {
            modalTitulo.textContent = info.titulo;
            modalDesc.textContent = info.descripcion;

            modalLista.innerHTML = info.caracteristicas.map(item => `
              <li class="bg-bosque-dark/80 p-2.5 rounded-xl border border-white/5 flex items-center">${item}</li>
            `).join('');

            modalGaleria.innerHTML = info.imagenes.map(img => `
              <div class="h-28 rounded-xl overflow-hidden border border-white/10">
                <img src="${img}" class="w-full h-full object-cover hover:scale-105 transition duration-300" />
              </div>
            `).join('');

            if (btnReservarDirecto) {
              btnReservarDirecto.onclick = () => {
                alojamientoSeleccionado = info.nombreReserva;
                precioSeleccionado = info.precio;
                if (cabanaSelect) cabanaSelect.value = tipo;
                resaltarCabanaVisual(tipo);
                modalDetalles?.classList.add('hidden');
                modalDetalles?.classList.remove('flex');
                document.querySelector('#reserva')?.scrollIntoView({ behavior: 'smooth' });
                actualizarResumen();
              };
            }

            modalDetalles?.classList.remove('hidden');
            modalDetalles?.classList.add('flex');
          }
        });
      });

      const cerrarModalDetalles = () => {
        modalDetalles?.classList.add('hidden');
        modalDetalles?.classList.remove('flex');
      };

      closeDetallesBtn?.addEventListener('click', cerrarModalDetalles);
      modalRegresarBtn?.addEventListener('click', () => {
        cerrarModalDetalles();
        document.querySelector('#hospedaje')?.scrollIntoView({ behavior: 'smooth' });
      });

      // Modal Reseñas
      const modalResenas = document.getElementById('modal-resenas');
      const contenedorResenas = document.getElementById('contenedor-resenas-lista');
      const formResena = document.getElementById('form-nueva-resena') as HTMLFormElement;
      let calificacionSeleccionada = 5;
      
      const resenasGuardadas = localStorage.getItem('valentura_resenas_global');
      let listaResenas = resenasGuardadas ? JSON.parse(resenasGuardadas) : [
        { nombre: 'Carlos Mendoza', estrellas: 5, comentario: 'Una experiencia increíble. Las cabañas son muy cómodas y limpias.' },
        { nombre: 'Sofía & Andrés', estrellas: 5, comentario: 'Excelente atención de la comunidad local. ¡Volveremos pronto!' }
      ];

      function renderizarResenas() {
        if (!contenedorResenas) return;
        contenedorResenas.innerHTML = '';
        listaResenas.forEach((resena: { nombre: string; estrellas: number; comentario: string }) => {
          contenedorResenas.innerHTML += `<div class="bg-bosque-dark/80 p-3 rounded-xl border border-white/5 text-xs"><div class="flex justify-between items-center mb-1"><span class="font-semibold text-white">${resena.nombre}</span><span class="text-dorado-primary">${'★'.repeat(resena.estrellas)}</span></div><p class="text-gray-300 font-light">${resena.comentario}</p></div>`;
        });
      }

      document.getElementById('open-resenas-hero')?.addEventListener('click', () => { 
        renderizarResenas(); 
        modalResenas?.classList.remove('hidden'); 
        modalResenas?.classList.add('flex'); 
      });

      document.getElementById('close-modal-resenas')?.addEventListener('click', () => {
        modalResenas?.classList.add('hidden');
        modalResenas?.classList.remove('flex');
      });

      document.querySelectorAll('#selector-estrellas .star').forEach(star => {
        star.addEventListener('click', () => { 
          calificacionSeleccionada = parseInt(star.getAttribute('data-rating') || '5'); 
          document.querySelectorAll('#selector-estrellas .star').forEach((s, idx) => {
            if (idx < calificacionSeleccionada) {
              s.classList.add('text-dorado-primary');
              s.classList.remove('opacity-50');
            } else {
              s.classList.remove('text-dorado-primary');
              s.classList.add('opacity-50');
            }
          }); 
        });
      });

      formResena?.addEventListener('submit', (e) => { 
        e.preventDefault(); 
        const nombreInput = (document.getElementById('nombre-resena') as HTMLInputElement);
        const comentarioInput = (document.getElementById('comentario-resena') as HTMLTextAreaElement);
        if(!nombreInput?.value || !comentarioInput?.value) return; 
        
        listaResenas.unshift({ nombre: nombreInput.value, estrellas: calificacionSeleccionada, comentario: comentarioInput.value }); 
        localStorage.setItem('valentura_resenas_global', JSON.stringify(listaResenas)); 
        renderizarResenas(); 
        formResena.reset(); 
        alert('¡Gracias! Tu reseña ha sido publicada con éxito.'); 
      });

      renderizarResenas();
    </script>
  </body>
</html>