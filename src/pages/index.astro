---
import '../styles/global.css';
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/jpg" href="/logo.jpg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reserva Ecológica Valentura</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-bosque-dark text-white font-['Plus_Jakarta_Sans',sans-serif] antialiased min-h-screen selection:bg-dorado-primary selection:text-bosque-dark">

    <!-- NAVBAR CON LOGO OFICIAL -->
    <header class="border-b border-white/10 backdrop-blur-md bg-bosque-dark/90 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 py-3.5 flex justify-between items-center">
        
        <a href="#inicio" class="flex items-center space-x-3 group">
          <img 
            src="/logo.jpg" 
            alt="Logo Reserva Ecológica Valentura" 
            class="w-11 h-11 rounded-full border border-dorado-primary/40 object-cover group-hover:scale-105 transition duration-300 shadow-md" 
          />
          <div>
            <span class="font-['Cinzel'] tracking-widest text-[10px] uppercase block text-gray-300 font-semibold leading-none">Reserva Ecológica</span>
            <span class="font-['Cinzel'] text-base tracking-widest text-dorado-primary font-bold block -mt-0.5">VALENTURA</span>
          </div>
        </a>

        <nav class="hidden md:flex items-center space-x-8 text-xs font-light text-gray-300 uppercase tracking-wider">
          <a href="#inicio" class="text-dorado-primary border-b border-dorado-primary pb-0.5">Inicio</a>
          <a href="#hospedaje" class="hover:text-dorado-light transition">Alojamiento</a>
          <a href="#santuario" class="hover:text-dorado-light transition">Fauna</a>
          <a href="#comunidad" class="hover:text-dorado-light transition">Comunidad</a>
          <a href="#reserva" class="hover:text-dorado-light transition">Reserva</a>
        </nav>

        <div class="flex items-center space-x-4 text-dorado-light text-sm">
          <button title="Buscar" class="hover:text-white transition">🔍</button>
          <button title="Favoritos" class="hover:text-white transition">🤍</button>
          <button class="md:hidden text-lg">☰</button>
        </div>
      </div>
    </header>

    <!-- HERO SECTION -->
    <section id="inicio" class="relative min-h-[75vh] flex items-center px-6 py-12 border-b border-white/5 overflow-hidden">
      <img 
        src="/hero-background-ia.jpg" 
        alt="Paisaje de la Reserva Ecológica Valentura" 
        class="absolute inset-0 w-full h-full object-cover z-0 filter brightness-[0.75]" 
      />
      
      <div class="absolute inset-0 bg-gradient-to-r from-bosque-dark/95 via-bosque-dark/80 to-transparent z-10"></div>

      <div class="max-w-7xl mx-auto w-full relative z-20 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8">
          <span class="text-dorado-light text-xs tracking-widest uppercase mb-2 block font-light">Bienvenidos a la</span>
          <h1 class="font-['Cinzel'] text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-normal text-white leading-tight mb-3">
            Reserva Ecológica <br/>
            <span class="text-dorado-primary font-semibold italic">Valentura</span>
          </h1>
          <p class="text-gray-300 text-sm sm:text-base mb-8 max-w-lg font-light leading-relaxed">
            Naturaleza, aventura y vida silvestre en un solo lugar.
          </p>
          <a href="#reserva" class="inline-flex items-center gap-3 bg-dorado-primary hover:bg-dorado-light text-bosque-dark px-6 py-3 rounded-full text-xs font-semibold tracking-wide transition duration-300 shadow-xl">
            Explorar la reserva <span class="text-sm">→</span>
          </a>
        </div>

        <div class="md:col-span-4 justify-self-end w-full max-w-xs">
          <div id="open-resenas-hero" class="bg-bosque-card/90 backdrop-blur-md border border-white/10 p-4 rounded-2xl flex items-center space-x-3.5 shadow-2xl cursor-pointer hover:border-dorado-primary/50 transition group">
            <div class="w-10 h-10 rounded-xl bg-bosque-accent flex items-center justify-center text-dorado-primary text-lg border border-white/5 group-hover:scale-110 transition">📍</div>
            <div class="text-xs">
              <p class="font-medium text-white">Mindo, Ecuador</p>
              <p class="text-gray-400 text-[11px]">San Miguel de los Bancos</p>
              <div class="flex items-center gap-1 mt-1 text-dorado-primary text-[11px]">
                <span id="puntuacion-promedio-hero" class="font-bold">4.9</span> 
                <span>★★★★★</span> 
                <span class="text-gray-400 font-normal hover:underline">(dejar reseña)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- GRID DE EXPERIENCIAS (5 TARJETAS CON TUS IMÁGENES) -->
    <section id="experiencias" class="max-w-7xl mx-auto px-6 py-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        
        <div class="bg-bosque-card border border-white/5 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-dorado-primary/50 transition duration-300 group cursor-pointer min-h-[240px] relative">
          <img src="/hospedaje.jpg" alt="Hospedaje" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 brightness-75" />
          <div class="absolute inset-0 bg-gradient-to-t from-bosque-dark via-bosque-dark/40 to-transparent"></div>
          <div class="relative z-10 p-4 flex justify-between items-start">
            <div class="w-8 h-8 rounded-lg bg-bosque-dark/80 backdrop-blur-md flex items-center justify-center text-sm border border-white/10">🏡</div>
          </div>
          <div class="relative z-10 p-4">
            <h3 class="font-semibold text-sm text-white group-hover:text-dorado-primary transition">Hospedaje</h3>
            <p class="text-[11px] text-gray-300 mt-0.5 leading-snug">Cabañas ecológicas inmersas del bosque</p>
          </div>
        </div>

        <div class="bg-bosque-card border border-white/5 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-dorado-primary/50 transition duration-300 group cursor-pointer min-h-[240px] relative">
          <img src="/tucan.jpg" alt="Flora y fauna" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 brightness-75" />
          <div class="absolute inset-0 bg-gradient-to-t from-bosque-dark via-bosque-dark/40 to-transparent"></div>
          <div class="relative z-10 p-4 flex justify-between items-start">
            <div class="w-8 h-8 rounded-lg bg-bosque-dark/80 backdrop-blur-md flex items-center justify-center text-sm border border-white/10">🦜</div>
          </div>
          <div class="relative z-10 p-4">
            <h3 class="font-semibold text-sm text-white group-hover:text-dorado-primary transition">Flora y fauna</h3>
            <p class="text-[11px] text-gray-300 mt-0.5 leading-snug">Especies únicas de la región</p>
          </div>
        </div>

        <div class="bg-bosque-card border border-white/5 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-dorado-primary/50 transition duration-300 group cursor-pointer min-h-[240px] relative">
          <img src="/perrito.jpg" alt="Santuario" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 brightness-75" />
          <div class="absolute inset-0 bg-gradient-to-t from-bosque-dark via-bosque-dark/40 to-transparent"></div>
          <div class="relative z-10 p-4 flex justify-between items-start">
            <div class="w-8 h-8 rounded-lg bg-bosque-dark/80 backdrop-blur-md flex items-center justify-center text-sm border border-white/10">🐾</div>
          </div>
          <div class="relative z-10 p-4">
            <h3 class="font-semibold text-sm text-white group-hover:text-dorado-primary transition">Santuario de animales</h3>
            <p class="text-[11px] text-gray-300 mt-0.5 leading-snug">Protegemos la vida silvestre</p>
          </div>
        </div>

        <div class="bg-bosque-card border border-white/5 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-dorado-primary/50 transition duration-300 group cursor-pointer min-h-[240px] relative">
          <img src="/cascada.jpg" alt="Cascadas y ríos" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 brightness-75" />
          <div class="absolute inset-0 bg-gradient-to-t from-bosque-dark via-bosque-dark/40 to-transparent"></div>
          <div class="relative z-10 p-4 flex justify-between items-start">
            <div class="w-8 h-8 rounded-lg bg-bosque-dark/80 backdrop-blur-md flex items-center justify-center text-sm border border-white/10">🌊</div>
          </div>
          <div class="relative z-10 p-4">
            <h3 class="font-semibold text-sm text-white group-hover:text-dorado-primary transition">Cascadas y ríos</h3>
            <p class="text-[11px] text-gray-300 mt-0.5 leading-snug">Aguas cristalinas y paisajes mágicos</p>
          </div>
        </div>

        <div class="bg-bosque-card border border-white/5 rounded-2xl overflow-hidden flex flex-col justify-between hover:border-dorado-primary/50 transition duration-300 group cursor-pointer min-h-[240px] relative">
          <img src="/comunidad.jpg" alt="Comunidad" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 brightness-75 filter blur-[1px]" />
          <div class="absolute inset-0 bg-gradient-to-t from-bosque-dark via-bosque-dark/60 to-transparent"></div>
          <div class="relative z-10 p-4 flex justify-between items-start">
            <div class="w-8 h-8 rounded-lg bg-bosque-dark/80 backdrop-blur-md flex items-center justify-center text-sm border border-white/10">👥</div>
          </div>
          <div class="relative z-10 p-4">
            <h3 class="font-semibold text-sm text-white group-hover:text-dorado-primary transition">Comunidad</h3>
            <p class="text-[11px] text-gray-300 mt-0.5 leading-snug">Cultura, tradición y gente local</p>
          </div>
        </div>

      </div>

      <!-- BANNER PROPÓSITO ECOLÓGICO -->
      <div class="mt-6 bg-bosque-card/80 border border-white/5 rounded-2xl p-6 flex flex-col sm:flex-row justify-between items-center gap-4">
        <div class="flex items-center space-x-4">
          <div class="w-10 h-10 rounded-full bg-bosque-accent flex items-center justify-center text-dorado-primary text-xl">🌱</div>
          <div>
            <h4 class="font-['Cinzel'] text-lg text-white">Un lugar para disfrutar y cuidar</h4>
            <p class="text-xs text-gray-400">Tu visita también apoya a la conservación medioambiental.</p>
          </div>
        </div>
        <a href="#comunidad" class="bg-bosque-accent hover:bg-white/10 text-dorado-light border border-dorado-primary/30 px-5 py-2.5 rounded-full text-xs transition whitespace-nowrap">
          Conoce más →
        </a>
      </div>
    </section>

    <!-- SECCIÓN HOSPEDAJE DETALLADO -->
    <section id="hospedaje" class="max-w-7xl mx-auto px-6 py-12 border-t border-white/5">
      <div class="flex flex-col md:flex-row justify-between md:items-end mb-8 gap-4">
        <div>
          <h2 class="font-['Cinzel'] text-3xl font-normal text-white">Hospedaje</h2>
          <p class="text-xs text-gray-400 mt-1">Cabañas acogedoras en medio del bosque</p>
        </div>

        <div class="flex flex-wrap gap-2 text-xs">
          <button class="filter-btn bg-dorado-primary text-bosque-dark font-semibold px-4 py-1.5 rounded-full transition" data-categoria="todos">Todos</button>
          <button class="filter-btn bg-bosque-card text-gray-300 hover:text-white px-4 py-1.5 rounded-full border border-white/5 transition" data-categoria="cabanas">Cabañas</button>
          <button class="filter-btn bg-bosque-card text-gray-300 hover:text-white px-4 py-1.5 rounded-full border border-white/5 transition" data-categoria="habitaciones">Habitaciones</button>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        
        <div class="card-hospedaje bg-bosque-card rounded-2xl overflow-hidden border border-white/5 hover:border-dorado-primary/40 transition group flex flex-col justify-between" data-categoria="cabanas">
          <div class="h-48 relative overflow-hidden flex items-center justify-center">
            <img src="/hospedaje.jpg" alt="Cabaña Familiar Bosque" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500" />
            <span class="absolute top-3 right-3 bg-bosque-dark/80 backdrop-blur-md px-2.5 py-1 rounded-full text-[10px] text-dorado-light border border-white/10 z-10">Popular</span>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-semibold text-white group-hover:text-dorado-primary transition">Cabaña Familiar Bosque</h3>
              <p class="text-xs text-gray-400 mt-1">3 Habitaciones · Sala · Baño con agua caliente · Wi-Fi</p>
            </div>
            <div class="flex justify-between items-center mt-6">
              <div>
                <span class="text-lg font-bold text-dorado-primary">$70</span>
                <span class="text-xs text-gray-400">/ noche</span>
              </div>
              <button class="btn-reservar-card text-xs text-dorado-light hover:underline font-medium" data-nombre="Cabaña Familiar Bosque" data-precio="70">Reservar →</button>
            </div>
          </div>
        </div>

        <div class="card-hospedaje bg-bosque-card rounded-2xl overflow-hidden border border-white/5 hover:border-dorado-primary/40 transition group flex flex-col justify-between" data-categoria="cabanas">
          <div class="h-48 relative overflow-hidden flex items-center justify-center">
            <img src="/hospedaje.jpg" alt="Cabaña Nido" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 filter brightness-90" />
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-semibold text-white group-hover:text-dorado-primary transition">Cabaña Nido</h3>
              <p class="text-xs text-gray-400 mt-1">Perfecta para descanso en parejas · Wi-Fi · Vista al bosque</p>
            </div>
            <div class="flex justify-between items-center mt-6">
              <div>
                <span class="text-lg font-bold text-dorado-primary">$50</span>
                <span class="text-xs text-gray-400">/ noche</span>
              </div>
              <button class="btn-reservar-card text-xs text-dorado-light hover:underline font-medium" data-nombre="Cabaña Nido" data-precio="50">Reservar →</button>
            </div>
          </div>
        </div>

        <div class="card-hospedaje bg-bosque-card rounded-2xl overflow-hidden border border-white/5 hover:border-dorado-primary/40 transition group flex flex-col justify-between" data-categoria="habitaciones">
          <div class="h-48 relative overflow-hidden flex items-center justify-center">
            <img src="/cascada.jpg" alt="Suite Mirador" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500" />
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-semibold text-white group-hover:text-dorado-primary transition">Suite Mirador</h3>
              <p class="text-xs text-gray-400 mt-1">Vista completa del dosel del bosque · Agua caliente</p>
            </div>
            <div class="flex justify-between items-center mt-6">
              <div>
                <span class="text-lg font-bold text-dorado-primary">$65</span>
                <span class="text-xs text-gray-400">/ noche</span>
              </div>
              <button class="btn-reservar-card text-xs text-dorado-light hover:underline font-medium" data-nombre="Suite Mirador" data-precio="65">Reservar →</button>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- SANTUARIO DE ANIMALES -->
    <section id="santuario" class="max-w-7xl mx-auto px-6 py-12 border-t border-white/5">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <span class="text-dorado-primary text-xs uppercase tracking-widest font-semibold block mb-1">Fauna Protegida</span>
          <h2 class="font-['Cinzel'] text-3xl text-white font-normal mb-3">Santuario de animales</h2>
          <p class="text-xs text-gray-300 leading-relaxed mb-6 font-light">
            Refugio para diversas especies nativas rescatadas y rehabilitadas. Visita de manera responsable y apoya nuestra labor de conservación.
          </p>

          <div class="grid grid-cols-2 gap-4 text-xs">
            <div class="bg-bosque-card p-3.5 rounded-xl border border-white/5">
              <p class="text-dorado-primary font-bold text-base">40+</p>
              <p class="text-gray-400 text-[11px]">Especies protegidas</p>
            </div>
            <div class="bg-bosque-card p-3.5 rounded-xl border border-white/5">
              <p class="text-dorado-primary font-bold text-base">100%</p>
              <p class="text-gray-400 text-[11px]">Libre e integrado</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="h-40 rounded-2xl overflow-hidden border border-white/5 relative">
            <img src="/perrito.jpg" alt="Santuario animal" class="w-full h-full object-cover" />
          </div>
          <div class="h-40 rounded-2xl overflow-hidden border border-white/5 relative">
            <img src="/tucan.jpg" alt="Tucán de Mindo" class="w-full h-full object-cover" />
          </div>
          <div class="h-40 rounded-2xl overflow-hidden border border-white/5 relative">
            <img src="/cascada.jpg" alt="Cascadas" class="w-full h-full object-cover" />
          </div>
          <div class="h-40 rounded-2xl overflow-hidden border border-white/5 relative">
            <img src="/hospedaje.jpg" alt="Reserva" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- COMUNIDAD -->
    <section id="comunidad" class="max-w-7xl mx-auto px-6 py-12 border-t border-white/5">
      <div class="bg-bosque-card rounded-3xl p-8 border border-white/10 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-5 h-56 rounded-2xl overflow-hidden border border-white/5 relative">
          <img src="/cascada.jpg" alt="Comunidad local" class="w-full h-full object-cover" />
        </div>
        <div class="md:col-span-7">
          <span class="text-dorado-primary text-xs uppercase tracking-widest font-semibold block mb-1">Impacto Social</span>
          <h2 class="font-['Cinzel'] text-2xl text-white font-normal mb-3">Comunidad y Cultura</h2>
          <p class="text-xs text-gray-300 leading-relaxed mb-6 font-light">
            Trabajamos mano a mano con familias locales para brindar experiencias auténticas de turismo sostenible, gastronomía artesanal y guianza tradicional.
          </p>
          <a href="#reserva" class="inline-block bg-bosque-accent hover:bg-white/10 text-dorado-light border border-dorado-primary/30 px-5 py-2.5 rounded-full text-xs transition">
            Conoce a nuestros guías →
          </a>
        </div>
      </div>
    </section>

    <!-- RESERVA Y MÉTODO DE PAGO -->
    <section id="reserva" class="max-w-7xl mx-auto px-6 py-12 border-t border-white/5">
      <div class="grid lg:grid-cols-12 gap-8">
        
        <div class="lg:col-span-8 bg-bosque-card rounded-3xl p-8 border border-white/10 shadow-2xl">
          <h2 class="font-['Cinzel'] text-2xl font-normal text-white mb-1">Reserva tu experiencia</h2>
          <p class="text-xs text-gray-400 mb-8">Elige tus fechas y asegura tu estancia en la Reserva Ecológica Valentura.</p>

          <form id="reserva-form" class="space-y-6">
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label class="text-xs text-dorado-light font-medium block mb-2">1. Fechas de entrada y salida</label>
                <div class="grid grid-cols-2 gap-2">
                  <input type="date" id="fecha-entrada" class="bg-bosque-dark border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary" required />
                  <input type="date" id="fecha-salida" class="bg-bosque-dark border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary" required />
                </div>
              </div>

              <div>
                <label class="text-xs text-dorado-light font-medium block mb-2">2. Número de huéspedes</label>
                <div class="grid grid-cols-2 gap-2">
                  <select id="adultos-select" class="bg-bosque-dark border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary">
                    <option>1 Adulto</option>
                    <option selected>2 Adultos</option>
                    <option>3 Adultos</option>
                    <option>4+ Adultos</option>
                  </select>
                  <select id="ninos-select" class="bg-bosque-dark border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary">
                    <option selected>0 Niños</option>
                    <option>1 Niño</option>
                    <option>2 Niños</option>
                  </select>
                </div>
              </div>
            </div>

            <div>
              <label class="text-xs text-dorado-light font-medium block mb-2">3. Método de Pago</label>
              <div class="grid grid-cols-2 gap-3 text-xs">
                <label class="flex items-center space-x-3 bg-bosque-dark p-3 rounded-xl border border-white/10 cursor-pointer hover:border-dorado-primary">
                  <input type="radio" name="pago" value="Transferencia / Depósito" checked class="accent-dorado-primary" />
                  <span>Transferencia / Depósito</span>
                </label>
                <label class="flex items-center space-x-3 bg-bosque-dark p-3 rounded-xl border border-white/10 cursor-pointer hover:border-dorado-primary">
                  <input type="radio" name="pago" value="Pago al llegar" class="accent-dorado-primary" />
                  <span>Pago al llegar</span>
                </label>
              </div>
            </div>

            <div class="grid md:grid-cols-2 gap-3 pt-2">
              <button type="submit" class="w-full bg-dorado-primary hover:bg-dorado-light text-bosque-dark py-3 rounded-xl text-xs font-bold tracking-wide transition shadow-lg">
                Confirmar reserva →
              </button>
              
              <button type="button" id="btn-whatsapp-reserva" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white py-3 rounded-xl text-xs font-bold tracking-wide transition shadow-lg flex items-center justify-center gap-2">
                <span>💬</span> Reservar por WhatsApp
              </button>
            </div>
          </form>
        </div>

        <div class="lg:col-span-4 bg-bosque-card rounded-3xl p-6 border border-white/10 flex flex-col justify-between">
          <div>
            <h3 class="font-['Cinzel'] text-lg text-white mb-4">Resumen de tu reserva</h3>
            <div class="space-y-3 text-xs border-b border-white/10 pb-4">
              <div class="flex justify-between text-gray-300">
                <span id="resumen-nombre">Cabaña Familiar Bosque (2 noches)</span>
                <span id="resumen-precio" class="text-white font-medium">$140</span>
              </div>
              <div class="flex justify-between text-gray-300">
                <span>Impuestos y conservación</span>
                <span class="text-white font-medium">$10</span>
              </div>
            </div>
            <div class="flex justify-between items-center mt-4">
              <span class="font-semibold text-white text-sm">Total</span>
              <span id="resumen-total" class="text-xl font-bold text-dorado-primary">$150</span>
            </div>
          </div>

          <div class="mt-6 bg-bosque-dark/60 p-4 rounded-xl border border-white/5 text-[11px] text-gray-400">
            🔒 Tu reserva está protegida con cancelación flexible hasta 48 horas antes.
          </div>
        </div>

      </div>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-white/10 bg-bosque-dark py-8 px-6 text-center text-xs text-gray-500">
      <p>© 2026 Reserva Ecológica Valentura. Todos los derechos reservados.</p>
    </footer>

    <!-- MODAL DE RESEÑAS Y TESTIMONIOS -->
    <div id="modal-resenas" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
      <div class="bg-bosque-card border border-white/10 w-full max-w-lg rounded-3xl p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
        <button id="close-modal-resenas" class="absolute top-4 right-4 text-gray-400 hover:text-white text-lg font-bold">✕</button>
        <h3 class="font-['Cinzel'] text-xl text-white mb-1">Opiniones de Visitantes</h3>
        <p class="text-xs text-gray-400 mb-6">Comparte tu experiencia en Reserva Ecológica Valentura</p>
        <form id="form-nueva-resena" class="bg-bosque-dark p-4 rounded-2xl border border-white/5 mb-6 space-y-3">
          <h4 class="text-xs font-semibold text-dorado-light uppercase tracking-wider">Escribir una reseña</h4>
          <div>
            <label class="text-[11px] text-gray-300 block mb-1">Calificación:</label>
            <div class="flex gap-2 text-xl cursor-pointer" id="selector-estrellas">
              <span data-rating="1" class="star hover:scale-110 transition opacity-50">★</span>
              <span data-rating="2" class="star hover:scale-110 transition opacity-50">★</span>
              <span data-rating="3" class="star hover:scale-110 transition opacity-50">★</span>
              <span data-rating="4" class="star hover:scale-110 transition opacity-50">★</span>
              <span data-rating="5" class="star hover:scale-110 transition text-dorado-primary">★</span>
            </div>
          </div>
          <div>
            <input type="text" id="nombre-resena" placeholder="Tu Nombre" class="w-full bg-bosque-card border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary" required />
          </div>
          <div>
            <textarea id="comentario-resena" rows="2" placeholder="Cuéntanos tu experiencia..." class="w-full bg-bosque-card border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary" required></textarea>
          </div>
          <button type="submit" class="w-full bg-dorado-primary hover:bg-dorado-light text-bosque-dark py-2 rounded-xl text-xs font-bold transition">Publicar Reseña</button>
        </form>
        <div class="space-y-3">
          <h4 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Reseñas recientes</h4>
          <div id="contenedor-resenas-lista" class="space-y-3 max-h-60 overflow-y-auto pr-1"></div>
        </div>
      </div>
    </div>

    <!-- JAVASCRIPT INTERACTIVO -->
    <script>
      let alojamientoSeleccionado = 'Cabaña Familiar Bosque';
      let precioSeleccionado = 70;

      const navLinks = document.querySelectorAll('header nav a, a[href^="#"]');
      navLinks.forEach(link => {
        link.addEventListener('click', (e) => {
          const targetId = link.getAttribute('href');
          if (targetId && targetId.startsWith('#')) {
            const targetElement = document.querySelector(targetId);
            targetElement?.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      const filterBtns = document.querySelectorAll('.filter-btn');
      const cardsHospedaje = document.querySelectorAll('.card-hospedaje');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => b.classList.remove('bg-dorado-primary', 'text-bosque-dark', 'font-semibold'));
          btn.classList.add('bg-dorado-primary', 'text-bosque-dark', 'font-semibold');
          const categoria = btn.getAttribute('data-categoria');
          cardsHospedaje.forEach(card => {
            const el = card as HTMLElement;
            if (categoria === 'todos' || card.getAttribute('data-categoria') === categoria) {
              el.style.display = 'flex';
            } else {
              el.style.display = 'none';
            }
          });
        });
      });

      const actionBtns = document.querySelectorAll('.btn-reservar-card');
      actionBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          alojamientoSeleccionado = btn.getAttribute('data-nombre') || 'Alojamiento Valentura';
          precioSeleccionado = parseInt(btn.getAttribute('data-precio') || '70');
          document.querySelector('#reserva')?.scrollIntoView({ behavior: 'smooth' });
          const elementoNombre = document.getElementById('resumen-nombre');
          const elementoPrecio = document.getElementById('resumen-precio');
          const elementoTotal = document.getElementById('resumen-total');
          if (elementoNombre) elementoNombre.textContent = `${alojamientoSeleccionado} (2 noches)`;
          if (elementoPrecio) elementoPrecio.textContent = `$${precioSeleccionado * 2}`;
          if (elementoTotal) elementoTotal.textContent = `$${precioSeleccionado * 2 + 10}`;
        });
      });

      document.getElementById('btn-whatsapp-reserva')?.addEventListener('click', () => {
        const fechaEntrada = (document.getElementById('fecha-entrada') as HTMLInputElement)?.value;
        const fechaSalida = (document.getElementById('fecha-salida') as HTMLInputElement)?.value;
        const adultos = (document.getElementById('adultos-select') as HTMLSelectElement)?.value;
        const ninos = (document.getElementById('ninos-select') as HTMLSelectElement)?.value;
        const metodoPago = (document.querySelector('input[name="pago"]:checked') as HTMLInputElement)?.value || 'Por definir';
        if (!fechaEntrada || !fechaSalida) {
          alert('Por favor selecciona las fechas de entrada y salida.');
          return;
        }
        const mensaje = `Hola Reserva Ecológica Valentura 🌿,\n\nDeseo realizar la siguiente reserva:\n\n🏡 Alojamiento: ${alojamientoSeleccionado}\n📅 Entrada: ${fechaEntrada}\n📅 Salida: ${fechaSalida}\n👥 Huéspedes: ${adultos}, ${ninos}\n💳 Método de Pago: ${metodoPago}\n💰 Total Estimado: $${precioSeleccionado * 2 + 10}\n\n¿Tienen disponibilidad para estas fechas?`;
        window.open(`https://wa.me/593995617678?text=${encodeURIComponent(mensaje)}`, '_blank');
      });

      const modalResenas = document.getElementById('modal-resenas');
      const contenedorResenas = document.getElementById('contenedor-resenas-lista');
      const formResena = document.getElementById('form-nueva-resena') as HTMLFormElement;
      let calificacionSeleccionada = 5;
      
      const resenasGuardadas = localStorage.getItem('valentura_resenas');
      let listaResenas = resenasGuardadas ? JSON.parse(resenasGuardadas) : [
        { nombre: 'Carlos Mendoza', estrellas: 5, comentario: 'Una experiencia increíble. La cabaña es muy cómoda.' },
        { nombre: 'Sofía & Andrés', estrellas: 5, comentario: 'Excelente atención de la comunidad local.' }
      ];

      function renderizarResenas() {
        if (!contenedorResenas) return;
        contenedorResenas.innerHTML = '';
        listaResenas.forEach((resena: { nombre: string; estrellas: number; comentario: string }) => {
          contenedorResenas.innerHTML += `<div class="bg-bosque-dark/80 p-3 rounded-xl border border-white/5 text-xs"><div class="flex justify-between items-center mb-1"><span class="font-semibold text-white">${resena.nombre}</span><span class="text-dorado-primary">${'★'.repeat(resena.estrellas)}</span></div><p class="text-gray-300 font-light">${resena.comentario}</p></div>`;
        });
      }

      document.getElementById('open-resenas-hero')?.addEventListener('click', () => { 
        renderizarResenas(); 
        modalResenas?.classList.remove('hidden'); 
        modalResenas?.classList.add('flex'); 
      });

      document.getElementById('close-modal-resenas')?.addEventListener('click', () => modalResenas?.classList.add('hidden'));

      document.querySelectorAll('#selector-estrellas .star').forEach(star => {
        star.addEventListener('click', () => { 
          calificacionSeleccionada = parseInt(star.getAttribute('data-rating') || '5'); 
          document.querySelectorAll('#selector-estrellas .star').forEach((s, idx) => {
            if (idx < calificacionSeleccionada) {
              s.classList.add('text-dorado-primary');
              s.classList.remove('opacity-50');
            } else {
              s.classList.remove('text-dorado-primary');
              s.classList.add('opacity-50');
            }
          }); 
        });
      });

      formResena?.addEventListener('submit', (e) => { 
        e.preventDefault(); 
        const nombreInput = (document.getElementById('nombre-resena') as HTMLInputElement);
        const comentarioInput = (document.getElementById('comentario-resena') as HTMLTextAreaElement);
        if(!nombreInput?.value || !comentarioInput?.value) return; 
        
        listaResenas.unshift({ nombre: nombreInput.value, estrellas: calificacionSeleccionada, comentario: comentarioInput.value }); 
        localStorage.setItem('valentura_resenas', JSON.stringify(listaResenas)); 
        renderizarResenas(); 
        formResena.reset(); 
        alert('¡Gracias! Tu reseña ha sido publicada.'); 
      });
    </script>
  </body>
</html>