---
import '../styles/global.css';
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reserva Ecológica Valentura</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-bosque-dark text-white font-['Plus_Jakarta_Sans',sans-serif] antialiased min-h-screen selection:bg-dorado-primary selection:text-bosque-dark">

    <!-- NAVBAR -->
    <header class="border-b border-white/10 backdrop-blur-md bg-bosque-dark/90 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 py-3.5 flex justify-between items-center">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-full border border-dorado-primary/40 flex items-center justify-center text-dorado-primary text-sm font-bold bg-bosque-accent">
            🌿
          </div>
          <div>
            <span class="font-['Cinzel'] tracking-widest text-xs uppercase block text-gray-300 font-semibold">Reserva Ecológica</span>
            <span class="font-['Cinzel'] text-base tracking-widest text-dorado-primary font-bold block -mt-1">VALENTURA</span>
          </div>
        </div>

        <nav class="hidden md:flex items-center space-x-8 text-xs font-light text-gray-300 uppercase tracking-wider">
          <a href="#inicio" class="text-dorado-primary border-b border-dorado-primary pb-0.5">Inicio</a>
          <a href="#hospedaje" class="hover:text-dorado-light transition">Alojamiento</a>
          <a href="#santuario" class="hover:text-dorado-light transition">Fauna</a>
          <a href="#reserva" class="hover:text-dorado-light transition">Reserva</a>
          <a href="#comunidad" class="hover:text-dorado-light transition">Comunidad</a>
        </nav>

        <div class="flex items-center space-x-4 text-dorado-light text-sm">
          <button title="Buscar" class="hover:text-white transition">🔍</button>
          <button title="Favoritos" class="hover:text-white transition">🤍</button>
          <button class="md:hidden text-lg">☰</button>
        </div>
      </div>
    </header>

    <!-- HERO SECTION -->
    <section id="inicio" class="relative min-h-[70vh] flex items-center px-6 py-12 border-b border-white/5 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-bosque-dark via-bosque-dark/85 to-transparent z-10"></div>
      <div class="absolute inset-0 bg-bosque-accent/30 z-0 flex items-center justify-center text-white/10 text-xl font-bold tracking-widest uppercase">
        [IMAGEN DE FONDO HERO - PAISAJE RESERVA]
      </div>

      <div class="max-w-7xl mx-auto w-full relative z-20 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-8">
          <span class="text-dorado-light text-xs tracking-widest uppercase mb-2 block font-light">Bienvenidos a la</span>
          <h1 class="font-['Cinzel'] text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-normal text-white leading-tight mb-3">
            Reserva Ecológica <br/>
            <span class="text-dorado-primary font-semibold italic">Valentura</span>
          </h1>
          <p class="text-gray-300 text-sm sm:text-base mb-8 max-w-lg font-light leading-relaxed">
            Naturaleza, aventura y vida silvestre en un solo lugar.
          </p>
          <a href="#reserva" class="inline-flex items-center gap-3 bg-dorado-primary hover:bg-dorado-light text-bosque-dark px-6 py-3 rounded-full text-xs font-semibold tracking-wide transition duration-300 shadow-xl">
            Explorar la reserva <span class="text-sm">→</span>
          </a>
        </div>

        <div class="md:col-span-4 justify-self-end w-full max-w-xs">
          <div class="bg-bosque-card/90 backdrop-blur-md border border-white/10 p-4 rounded-2xl flex items-center space-x-3.5 shadow-2xl">
            <div class="w-10 h-10 rounded-xl bg-bosque-accent flex items-center justify-center text-dorado-primary text-lg border border-white/5">📍</div>
            <div class="text-xs">
              <p class="font-medium text-white">Mindo, Ecuador</p>
              <p class="text-gray-400 text-[11px]">San Miguel de los Bancos</p>
              <div class="flex items-center gap-1 mt-1 text-dorado-primary text-[11px]">
                <span class="font-bold">4.9</span> <span>★★★★★</span> <span class="text-gray-400 font-normal">(reseñas)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SANTUARIO DE ANIMALES -->
    <section id="santuario" class="max-w-7xl mx-auto px-6 py-12 border-t border-white/5">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div>
          <span class="text-dorado-primary text-xs uppercase tracking-widest font-semibold block mb-1">Fauna Protegida</span>
          <h2 class="font-['Cinzel'] text-3xl text-white font-normal mb-3">Santuario de animales</h2>
          <p class="text-xs text-gray-300 leading-relaxed mb-6 font-light">
            Refugio para diversas especies nativas rescatadas y rehabilitadas. Visita de manera responsable y apoya nuestra labor de conservación.
          </p>

          <div class="grid grid-cols-2 gap-4 text-xs">
            <div class="bg-bosque-card p-3.5 rounded-xl border border-white/5">
              <p class="text-dorado-primary font-bold text-base">40+</p>
              <p class="text-gray-400 text-[11px]">Especies protegidas</p>
            </div>
            <div class="bg-bosque-card p-3.5 rounded-xl border border-white/5">
              <p class="text-dorado-primary font-bold text-base">100%</p>
              <p class="text-gray-400 text-[11px]">Libre e integrado</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div class="bg-bosque-accent h-40 rounded-2xl flex items-center justify-center text-[10px] text-white/30 border border-white/5">[FOTO MONO]</div>
          <div class="bg-bosque-accent h-40 rounded-2xl flex items-center justify-center text-[10px] text-white/30 border border-white/5">[FOTO TUCÁN]</div>
          <div class="bg-bosque-accent h-40 rounded-2xl flex items-center justify-center text-[10px] text-white/30 border border-white/5">[FOTO MARIPOSA]</div>
          <div class="bg-bosque-accent h-40 rounded-2xl flex items-center justify-center text-[10px] text-white/30 border border-white/5">[FOTO REPTIL]</div>
        </div>
      </div>
    </section>

    <!-- COMUNIDAD -->
    <section id="comunidad" class="max-w-7xl mx-auto px-6 py-12 border-t border-white/5">
      <div class="bg-bosque-card rounded-3xl p-8 border border-white/10 grid md:grid-cols-12 gap-8 items-center">
        <div class="md:col-span-5 bg-bosque-accent h-56 rounded-2xl flex items-center justify-center text-xs text-white/30 border border-white/5">
          [FOTO COMUNIDAD LOCAL]
        </div>
        <div class="md:col-span-7">
          <span class="text-dorado-primary text-xs uppercase tracking-widest font-semibold block mb-1">Impacto Social</span>
          <h2 class="font-['Cinzel'] text-2xl text-white font-normal mb-3">Comunidad y Cultura</h2>
          <p class="text-xs text-gray-300 leading-relaxed mb-6 font-light">
            Trabajamos mano a mano con familias locales para brindar experiencias auténticas de turismo sostenible, gastronomía artesanal y guianza tradicional.
          </p>
          <a href="#reserva" class="inline-block bg-bosque-accent hover:bg-white/10 text-dorado-light border border-dorado-primary/30 px-5 py-2.5 rounded-full text-xs transition">
            Conoce a nuestros guías →
          </a>
        </div>
      </div>
    </section>

    <!-- RESERVA Y MÉTODO DE PAGO -->
    <section id="reserva" class="max-w-7xl mx-auto px-6 py-12 border-t border-white/5">
      <div class="grid lg:grid-cols-12 gap-8">
        
        <!-- Formulario Reserva -->
        <div class="lg:col-span-8 bg-bosque-card rounded-3xl p-8 border border-white/10 shadow-2xl">
          <h2 class="font-['Cinzel'] text-2xl font-normal text-white mb-1">Reserva tu experiencia</h2>
          <p class="text-xs text-gray-400 mb-8">Elige tus fechas y asegura tu estancia en la Reserva Ecológica Valentura.</p>

          <form id="reserva-form" class="space-y-6">
            <div class="grid md:grid-cols-2 gap-4">
              <div>
                <label class="text-xs text-dorado-light font-medium block mb-2">1. Fechas de entrada y salida</label>
                <div class="grid grid-cols-2 gap-2">
                  <input type="date" class="bg-bosque-dark border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary" required />
                  <input type="date" class="bg-bosque-dark border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary" required />
                </div>
              </div>

              <div>
                <label class="text-xs text-dorado-light font-medium block mb-2">2. Número de huéspedes</label>
                <div class="grid grid-cols-2 gap-2">
                  <select class="bg-bosque-dark border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary">
                    <option>1 Adulto</option>
                    <option selected>2 Adultos</option>
                    <option>3+ Adultos</option>
                  </select>
                  <select class="bg-bosque-dark border border-white/10 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-dorado-primary">
                    <option>0 Niños</option>
                    <option>1 Niño</option>
                  </select>
                </div>
              </div>
            </div>

            <div>
              <label class="text-xs text-dorado-light font-medium block mb-2">3. Método de Pago</label>
              <div class="grid grid-cols-2 gap-3 text-xs">
                <label class="flex items-center space-x-3 bg-bosque-dark p-3 rounded-xl border border-white/10 cursor-pointer hover:border-dorado-primary">
                  <input type="radio" name="pago" checked class="accent-dorado-primary" />
                  <span>Transferencia / Depósito</span>
                </label>
                <label class="flex items-center space-x-3 bg-bosque-dark p-3 rounded-xl border border-white/10 cursor-pointer hover:border-dorado-primary">
                  <input type="radio" name="pago" class="accent-dorado-primary" />
                  <span>Pago al llegar</span>
                </label>
              </div>
            </div>

            <button type="submit" class="w-full bg-dorado-primary hover:bg-dorado-light text-bosque-dark py-3 rounded-xl text-xs font-bold tracking-wide transition shadow-lg">
              Confirmar reserva →
            </button>
          </form>
        </div>

        <!-- Resumen de Pago / Tarjeta lateral -->
        <div class="lg:col-span-4 bg-bosque-card rounded-3xl p-6 border border-white/10 flex flex-col justify-between">
          <div>
            <h3 class="font-['Cinzel'] text-lg text-white mb-4">Resumen de tu reserva</h3>
            <div class="space-y-3 text-xs border-b border-white/10 pb-4">
              <div class="flex justify-between text-gray-300">
                <span>Cabaña Senderos (2 noches)</span>
                <span class="text-white font-medium">$140</span>
              </div>
              <div class="flex justify-between text-gray-300">
                <span>Impuestos y conservación</span>
                <span class="text-white font-medium">$10</span>
              </div>
            </div>
            <div class="flex justify-between items-center mt-4">
              <span class="font-semibold text-white text-sm">Total</span>
              <span class="text-xl font-bold text-dorado-primary">$150</span>
            </div>
          </div>

          <div class="mt-6 bg-bosque-dark/60 p-4 rounded-xl border border-white/5 text-[11px] text-gray-400">
            🔒 Tu reserva está protegida con cancelación flexible hasta 48 horas antes.
          </div>
        </div>

      </div>
    </section>

    <!-- FOOTER -->
    <footer class="border-t border-white/10 bg-bosque-dark py-8 px-6 text-center text-xs text-gray-500">
      <p>© 2026 Reserva Ecológica Valentura. Todos los derechos reservados.</p>
    </footer>

    <script>
      const form = document.getElementById('reserva-form');
      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('¡Reserva confirmada con éxito!');
      });
    </script>
  </body>
</html>